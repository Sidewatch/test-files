#usda 1.0
(
    defaultPrim = "Rocket"
    doc = "A toy rocket, a Sidewatch test model (make-models.py)."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Rocket" (
    kind = "component"
)
{
    def Scope "Materials"
    {
        def Material "Body"
        {
            token outputs:surface.connect = </Rocket/Materials/Body/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Rocket/Materials/Body/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @sample-uv-checker.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Rocket/Materials/Body/TexCoords.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "TexCoords"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Paint"
        {
            token outputs:surface.connect = </Rocket/Materials/Paint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.12, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Metal"
        {
            token outputs:surface.connect = </Rocket/Materials/Metal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.66)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Glass"
        {
            token outputs:surface.connect = </Rocket/Materials/Glass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.5, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }

        def Material "Nozzle"
        {
            token outputs:surface.connect = </Rocket/Materials/Nozzle/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.18, 0.2)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

    def Mesh "Body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
