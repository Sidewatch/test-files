# systemd 258 — unit file syntax showcase
# ── Comments ──
# systemd unit for the inventory API, exercising every section and value form.
; Semicolon comments are accepted as well.
# TODO: switch to socket activation
# FIXME: the reload signal races with migrations

[Unit]
Description=Inventory API
Documentation=https://example.com/docs/inventory man:inventory(8) file:/usr/share/doc/inventory/README
Documentation=info:inventory
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
Requisite=local-fs.target
BindsTo=sys-subsystem-net-devices-eth0.device
PartOf=inventory.target
Conflicts=inventory-legacy.service
Before=multi-user.target
OnFailure=notify-failure@%n.service
ConditionPathExists=/etc/inventory/config.toml
ConditionPathIsDirectory=!/var/lib/inventory/.lock
ConditionHost=|inventory-*
ConditionACPower=true
AssertFileNotEmpty=/etc/inventory/config.toml
StartLimitIntervalSec=300
StartLimitBurst=5
StartLimitAction=none
RequiresMountsFor=/var/lib/inventory
JobTimeoutSec=infinity
SourcePath=/etc/inventory/inventory.conf

[Service]
# ── Process management ──
Type=notify
NotifyAccess=main
User=inventory
Group=inventory
SupplementaryGroups=ssl-cert adm
DynamicUser=no
UMask=0027
WorkingDirectory=/opt/inventory
RootDirectory=/srv/jail
Nice=-5
OOMScoreAdjust=-200
IOSchedulingClass=best-effort
IOSchedulingPriority=4
CPUSchedulingPolicy=other

# ── Environment ──
Environment="LOG_LEVEL=info" "REGION=eu-west" WAREHOUSE_ID=42
Environment="MESSAGE=hello world with spaces" 'SINGLE=quoted value'
EnvironmentFile=-/etc/inventory/env
EnvironmentFile=/etc/inventory/secrets.env
PassEnvironment=LANG TZ
UnsetEnvironment=DEBUG
Environment=
SetCredential=api_token:example-not-a-real-token
LoadCredential=db_password:/etc/inventory/credentials/db
ImportCredential=inventory.*

# ── Commands ──
ExecStartPre=/opt/inventory/bin/migrate --check
ExecStartPre=-/bin/mkdir -p /run/inventory
ExecStartPre=+/bin/chown inventory /run/inventory
ExecStartPre=!/opt/inventory/bin/privileged-setup
ExecStartPre=!!/opt/inventory/bin/ambient-setup
ExecStartPre=:/opt/inventory/bin/no-env-subst --raw $HOME
ExecStart=/opt/inventory/bin/inventory --port 8080 --config /etc/inventory/config.toml \
    --workers ${WORKERS} --region $REGION --name "main instance" --literal 'single quoted' \
    --percent %% --unit %n --instance %i --host %H --user %u
ExecStartPost=/bin/sh -c 'echo started > /run/inventory/status'
ExecReload=/bin/kill -HUP $MAINPID
ExecReload=@/bin/kill kill-alias -HUP $MAINPID
ExecStop=/opt/inventory/bin/inventory --shutdown
ExecStopPost=-/bin/rm -f /run/inventory/status
ExecCondition=/bin/test -r /etc/inventory/config.toml

# ── Lifecycle ──
Restart=on-failure
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=1min
TimeoutStartSec=90
TimeoutStopSec=30s
TimeoutAbortSec=10
TimeoutSec=2min 30s
WatchdogSec=30
RuntimeMaxSec=1d 12h
SuccessExitStatus=0 143 SIGTERM
RestartPreventExitStatus=64 USAGE
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes
FinalKillSignal=SIGKILL
RemainAfterExit=no
GuessMainPID=yes
PIDFile=/run/inventory/inventory.pid
RuntimeDirectory=inventory
RuntimeDirectoryMode=0750
StateDirectory=inventory
CacheDirectory=inventory
LogsDirectory=inventory
ConfigurationDirectory=inventory

# ── Resource control ──
LimitNOFILE=65536
LimitNPROC=4096:8192
LimitCORE=infinity
LimitMEMLOCK=64M
MemoryMax=2G
MemoryHigh=1536M
MemorySwapMax=0
CPUQuota=200%
CPUWeight=500
TasksMax=512
IOWeight=100
IPAddressAllow=192.0.2.0/24 2001:db8::/32 localhost
IPAddressDeny=any
DeviceAllow=/dev/null rw
DevicePolicy=closed
Slice=inventory.slice
Delegate=no

# ── Logging ──
StandardInput=null
StandardOutput=journal
StandardError=inherit
SyslogIdentifier=inventory
SyslogFacility=daemon
SyslogLevel=info
SyslogLevelPrefix=true
LogLevelMax=notice
LogExtraFields=SERVICE_TIER=api
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

# ── Hardening ──
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/inventory /run/inventory
ReadOnlyPaths=/etc/inventory
InaccessiblePaths=/root -/nonexistent
BindPaths=/var/lib/inventory:/data:rbind
BindReadOnlyPaths=/etc/ssl
TemporaryFileSystem=/var:ro
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=false
PrivateUsers=true
PrivateMounts=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_CHOWN
CapabilityBoundingSet=~CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
NoExecPaths=/home
ExecPaths=/opt/inventory
PAMName=inventory
SELinuxContext=system_u:system_r:inventory_t:s0
AppArmorProfile=-usr.bin.inventory
Personality=x86-64
CoredumpFilter=default
TimerSlackNSec=50ms

[Install]
WantedBy=multi-user.target
RequiredBy=inventory.target
Also=inventory.socket
Alias=inventory-api.service
DefaultInstance=main

# ── Drop-in style overrides: empty assignment resets a list ──
[Service]
ExecStart=
ExecStart=/opt/inventory/bin/inventory --port 8081
Environment="OVERRIDE=1"

# ── More [Unit] directives: dependencies, conditions, assertions, actions ──
[Unit]
DefaultDependencies=no
Upholds=inventory-worker.service
PropagatesStopTo=inventory-cache.service
PropagatesReloadTo=inventory-cache.service
ReloadPropagatedFrom=inventory.target
JoinsNamespaceOf=nginx.service
OnSuccess=inventory-report.service
OnSuccessJobMode=replace
OnFailureJobMode=isolate
StopWhenUnneeded=no
RefuseManualStart=no
RefuseManualStop=no
AllowIsolate=no
IgnoreOnIsolate=no
CollectMode=inactive-or-failed
FailureAction=none
SuccessAction=none
SuccessActionExitStatus=0
JobRunningTimeoutSec=10min
JobTimeoutAction=none
JobTimeoutRebootArgument=safe-mode
ConditionKernelVersion=>=6.1
ConditionKernelCommandLine=!debug
ConditionArchitecture=x86-64
ConditionVirtualization=!container
ConditionFirmware=uefi
ConditionSecurity=selinux
ConditionCapability=CAP_NET_ADMIN
ConditionControlGroupController=cpu memory
ConditionMemory=>=2G
ConditionCPUs=>=2
ConditionEnvironment=REGION=eu-west
ConditionFirstBoot=no
ConditionNeedsUpdate=|/etc
ConditionUser=inventory
ConditionGroup=inventory
ConditionCredential=inventory.token
ConditionOSRelease=ID=debian
ConditionFileIsExecutable=/opt/inventory/bin/inventory
ConditionFileNotEmpty=/etc/inventory/config.toml
ConditionDirectoryNotEmpty=/etc/inventory/conf.d
ConditionPathExistsGlob=/etc/inventory/*.toml
ConditionPathIsMountPoint=/var/lib/inventory
ConditionPathIsReadWrite=/var/lib/inventory
ConditionPathIsSymbolicLink=/etc/inventory/current
ConditionPathIsEncrypted=/var/lib/inventory
ConditionPathExists=|/etc/inventory/a.toml
ConditionPathExists=|/etc/inventory/b.toml
AssertPathExists=/etc/inventory
AssertACPower=yes
AssertSecurity=apparmor
AssertVirtualization=no
Description=Inventory API on %H (%i)

# ── More [Service] directives: process types, namespaces, credentials ──
[Service]
Type=exec
ExitType=main
RestartMode=normal
OOMPolicy=stop
FileDescriptorStoreMax=16
FileDescriptorStorePreserve=restart
BusName=com.example.Inventory
ExecSearchPath=/opt/inventory/bin:/usr/local/bin
MemoryPressureWatch=auto
MemoryPressureThresholdSec=200ms
OpenFile=/var/lib/inventory/db.sock:db:read-only
RootImage=/var/lib/machines/inventory.raw
RootImageOptions=root:ro,noatime
RootHash=0123456789abcdef
RootVerity=/var/lib/machines/inventory.verity
MountImages=/var/lib/data.raw:/data:ro
ExtensionImages=/var/lib/extensions/tools.raw
ExtensionDirectories=/var/lib/extensions/extra
MountAPIVFS=yes
BindLogSockets=yes
PrivateIPC=yes
PrivatePIDs=yes
PrivateBPF=yes
ProtectHostname=private:inventory
ProtectSystem=full
ProtectHome=read-only
ProtectHome=tmpfs
LogNamespace=inventory
LogFilterPatterns=~noisy line
LogLevelMax=debug
SetCredentialEncrypted=api_key:Zm9v
LoadCredentialEncrypted=db_password:/etc/inventory/credentials/db.enc
NetworkNamespacePath=/run/netns/inventory
IPAccounting=yes
IPIngressFilterPath=/sys/fs/bpf/inventory-in
IPEgressFilterPath=/sys/fs/bpf/inventory-out
CPUAffinity=0-3 8
NUMAPolicy=local
NUMAMask=0
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
TasksAccounting=yes
MemoryMin=256M
MemoryLow=512M
MemoryZSwapMax=1G
StartupMemoryMax=3G
ManagedOOMSwap=kill
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=60%
DisableControllers=io
DelegateSubgroup=supervisor
CoredumpReceive=no
RestrictFileSystems=ext4 tmpfs
RestrictNetworkInterfaces=eth0
RestrictNamespaces=~user pid
KeyringMode=private
LimitRTPRIO=0
LimitRTTIME=infinity
LimitCPU=10min
LimitAS=4G
LimitDATA=infinity
LimitFSIZE=1G
LimitLOCKS=100
LimitMSGQUEUE=819200
LimitNICE=0
LimitRSS=infinity
LimitSIGPENDING=63000
LimitSTACK=8M
DeviceAllow=char-tty rw
DeviceAllow=block-sd r
DeviceAllow=/dev/net/tun rwm
IPAddressAllow=
SystemCallFilter=~@mount:EPERM
SystemCallLog=@debug
SystemCallArchitectures=x86 x86-64
LockPersonality=yes
ProtectProc=ptraceable
ProcSubset=all
ReadWriteDirectories=/var/lib/inventory
ExecPaths=/opt/inventory
NoExecPaths=/tmp
ExecStartPre=+-/bin/true
ExecStartPre=-!/bin/true
ExecStartPre=!!-/bin/true
ExecStart=/bin/echo one ; /bin/echo two
ExecStart=/bin/sh -c 'echo "quoted $$HOME and %%"'
ExecStart=/bin/echo "escapes: \x41 \n \t \\ \" \101 \u00e9 \U0001F3ED"
ExecStart=/bin/echo ${LOG_LEVEL} ${WAREHOUSE_ID} $MAINPID $INVOCATION_ID $$
ExecStart=/bin/echo $EXIT_CODE $EXIT_STATUS $SERVICE_RESULT $MONITOR_UNIT $CREDENTIALS_DIRECTORY
ExecStart=/bin/echo $RUNTIME_DIRECTORY $STATE_DIRECTORY $CACHE_DIRECTORY $LOGS_DIRECTORY $CONFIGURATION_DIRECTORY
ExecStart=/bin/echo $NOTIFY_SOCKET $WATCHDOG_PID $WATCHDOG_USEC $LISTEN_FDS $LISTEN_PID $LISTEN_FDNAMES
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=file:/var/log/inventory.log
StandardError=append:/var/log/inventory.err
StandardOutput=truncate:/var/log/inventory.out
StandardOutput=socket
StandardError=journal+console
StandardOutput=fd:stdout
StandardInputText=hello\n
StandardInputData=SGVsbG8K
SyslogLevel=debug
Sockets=inventory.socket
WatchdogSignal=SIGABRT
NotifyAccess=all
TimeoutStartFailureMode=terminate
TimeoutStopFailureMode=abort
EnvironmentFile=-/etc/inventory/env.d/*.env
PassEnvironment=
Environment=PATH=/usr/local/bin:/usr/bin
Environment=ESCAPED="a \"quoted\" word" SPACED=two\ words
Environment=SPECIFIER=%t/%N/%p/%P/%i/%I/%f/%S/%C/%L/%E/%T/%V/%h/%U/%u/%G/%g/%s/%m/%b/%H/%l/%v/%a/%o/%w/%W/%M/%A/%B/%q/%j/%J/%d

# ── Time spans, sizes, booleans, and numeric forms ──
[Service]
TimeoutStartSec=1h 30min 5us
TimeoutStopSec=infinity
RuntimeMaxSec=1w 2d 3h 4min 5s 6ms 7us
RestartSec=0.5s
WatchdogSec=1month 1y
MemoryMax=infinity
MemoryHigh=512K
MemoryLow=1T
MemorySwapMax=50%
LimitMEMLOCK=1P
LimitCORE=0
CPUWeight=idle
IOWeight=100
Nice=19
UMask=0077
ProtectKernelTunables=on
ProtectClock=off
NoNewPrivileges=1
PrivateTmp=0
PrivateUsers=full
PrivateTmp=disconnected
RemainAfterExit=y
SendSIGHUP=n
SendSIGKILL=True
Delegate=cpu memory pids
TasksMax=infinity
TasksMax=10%
AmbientCapabilities=~
CapabilityBoundingSet=
SupplementaryGroups=
OOMScoreAdjust=1000
Environment=ONE=1 \
    TWO=2 \
# a comment line inside a continuation is skipped
    THREE=3

# ── [Install] extras, vendor extension section, and template instances ──
[Install]
UpheldBy=multi-user.target
WantedBy=inventory@main.service inventory@%i.service
Alias=inventory.service
Also=inventory-reload.path inventory-reload.timer
DefaultInstance=main

[X-Inventory]
; Sections whose name starts with X- are ignored by systemd and kept for other tools.
Owner=platform@example.com
Tier=api
