/* ── Missing values and special literals ── */
data literals;
    a = .;
    b = .A;
    c = ._;
    d = 1.5e3;
    e = 1E-3;
    f = 0x1F;
    g = 'it''s single';
    h = "double ""quoted"" text";
    i = '01JAN2026'd;
    j = '12:30:00't;
    k = '01JAN2026:12:30:00'dt;
    l = 'ff'x;
    m = '1010'b;
    n = "name with space"n;
    o = 'hello'n;
    p = 5 ** 2 || 'a' !! 'b';
    q = (a = 1) + (a ne 2) + (a ^= 3) + (a ~= 4) + (a < 5) + (a <= 6) + (a > 7) + (a >= 8);
    r = a in (1, 2, 3) and not b or c;
    s = a eq 1 and b gt 2 or c lt 3 and d ge 4 or e le 5;
    t = min(1, 2) <> 3 >< 4;
    u = -a + +b * c / d;
    v = a || b || c;
run;

