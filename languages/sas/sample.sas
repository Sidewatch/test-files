/* ── PROC steps ── */
proc sql noprint;
    create table by_status as
    select status, count(*) as n, sum(total) as revenue format=comma10.2 label='Revenue',
           avg(total) as mean_total, max(total) as largest
    from orders as o left join inv.customers as c on o.cust_id = c.id
    where o.total > &reorder_point and status like 'p%' and number in (select number from work.low_stock)
    group by status
    having calculated revenue > 0
    order by revenue desc, status asc;

    select count(*) into :n_rows trimmed from by_status;
    select distinct status into :statuses separated by ',' from orders;
    insert into orders (number, total) values (5, 12.5) values (6, 0);
    update orders set total = total * 1.1 where status = 'paid';
    delete from orders where total = 0;
    alter table orders add region char(8);
    drop table work.scratch;
    describe table orders;
    create index status on orders(status);
    create view v_paid as select * from orders where paid = 1;
    select case when total > 100 then 'high' when total > 10 then 'mid' else 'low' end as band from orders;
    select a.*, b.name from a inner join b on a.id = b.id union all select * from c except select * from d;
quit;

proc sort data=orders out=sorted nodupkey; by descending total status; run;

proc means data=orders n mean max min std sum maxdec=2 noprint;
    class status;
    where paid;
    var total;
    output out=stats mean=avg_total sum=sum_total / autoname;
run;

proc freq data=orders;
    tables status * paid / chisq nocol norow nopercent out=freqs;
run;

proc print data=sorted(obs=10) noobs label;
    var number total status;
    format total dollar10.2;
    sum total;
run;

proc report data=orders nowd headline;
    column status total n;
    define status / group "Status";
    define total / analysis sum format=dollar12.2;
    define n / "Count";
    break after status / summarize;
    compute after;
        status = 'All';
    endcomp;
run;

