proc ds2;
    data work.ds2_out / overwrite=yes;
        declare double total having format dollar12.2 label 'Total';
        declare varchar(20) name;
        declare package hash h();
        method init();
            total = 0;
        end;
        method run();
            set inv.orders;
            total = total + amount;
            output;
        end;
        method term();
            put 'done';
        end;
        method double_it(double x) returns double;
            return x * 2;
        end;
    enddata;
run;
quit;

