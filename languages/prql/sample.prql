# PRQL 0.13 — syntax showcase
# ── Comments ──
# PRQL showcase: warehouse revenue and stock analysis.
#! A doc-style comment (shebang-ish) at the top of a file
# TODO: parameterise the date range. FIXME: currency conversion.

# ── Header: version, dialect target, module imports ──
prql version:"0.13" target:sql.postgres

module inv {
  let tax_rate = 0.075
  let net = price -> price / (1 + tax_rate)
}

# ── Constants, numbers and literals ──
let numbers = [
  42, 1_000_000, -7, 3.14, 1e3, 1.5e-3, 0xff, 0o17, 0b1010,
  null, true, false,
]

let strings = [
  "double \"quoted\" with \n escapes \t and \u{1F4E6}",
  'single quoted',
  """triple
  quoted""",
  r"raw \n string",
  f"formatted {tax_rate} string",
  s"upper({name})",
]

let dates = [@2026-01-01, @2026-09-24T12:30:00Z, @08:30:15, @2026-09-24T12:30:00+02:00]
let durations = [1years, 3months, 2weeks, 5days, 12hours, 30minutes, 15seconds, 100milliseconds, 5microseconds]

# ── Functions, with defaults and named params ──
let add = a b -> a + b
let discounted = price rate:0.1 -> price * (1 - rate)
let in_range = value low high -> low <= value && value <= high
let tier = x -> (
  case [
    x >= 1000 => "gold",
    x >= 100 => "silver",
    true => "bronze",
  ]
)

# ── Pipelines and transforms ──
let paid = (
  from orders
  filter status == "paid"
  filter placed_at >= @2026-01-01 && placed_at < @2027-01-01
  filter !is_test
  filter (status | in ["paid", "shipped"])
  filter customer_id != null
  filter total ?? 0 > 0
)

let revenue = (
  from paid
  join side:left customers (==customer_id)
  join items (this.id == that.order_id)
  join side:inner products (items.sku == products.sku)
  derive {
    revenue = items.quantity * items.unit_price,
    month = s"date_trunc('month', {placed_at})",
    net = inv.net revenue,
    label = f"{customers.name} <{customers.email}>",
    margin = (revenue - products.cost) / revenue * 100,
    bucket = revenue / 100 // 1,
    leftover = revenue % 100,
    power = 2 ** 8,
    ok = revenue > 0 && !(margin < 5) || is_vip,
    maybe = customers.region ?? "unknown",
    match_name = customers.name ~= "^A",
    neg = -revenue,
  }
  group {month, customers.region} (
    aggregate {
      order_count = count_distinct orders.id,
      total = sum revenue,
      avg_order = average revenue,
      biggest = max revenue,
      smallest = min revenue,
      n = count this,
      any_vip = any is_vip,
      all_ok = all ok,
      joined = concat_array tags,
    }
  )
  sort {-month, +total, region}
  take 1..12
)

# ── More transforms: window, select, append, loop, sort ──
from stock
select {sku, bin, qty}
select !{internal_id}
rename {warehouse = wh}
append (from stock_archive | select {sku, bin, qty})
remove (from discontinued)
intersect (from active_skus)
loop (
  filter qty < 1000
  derive qty = qty * 2
)
window rolling:7 (
  derive {seven_day_avg = average qty}
)
window rows:-3..0 expanding:true (
  derive {running = sum qty}
)
window range:-1..1 (
  derive {neighbours = lag 1 qty}
)
group sku (
  sort {-updated_at}
  take 1
)
derive {
  rank = row_number this,
  prev = lag 1 qty,
  next = lead 1 qty,
  first_qty = first qty,
  last_qty = last qty,
  nth_qty = nth 2 qty,
  pct = rank / count this,
}
take 10..
take ..5
sort {-total}
filter (total | in 100..500)

# ── Dialect-specific, tuple and array features ──
let lookup = (
  from_text format:json '''
    [{"sku": "AC-1001", "qty": 25}]
  '''
)

from_text format:csv """
sku,qty
AC-1001,25
AC-1002,3
"""

from_text format:json '{"columns": ["sku", "qty"], "data": [["AC-1001", 25]]}'

# ── Final result: type annotations, tuples, ranges ──
let typed = (x <int> y <text> -> x)
let tuple_example = {a = 1, b = {c = 2, d = [3, 4]}}
let range_example = 1..10

from paid
derive {x = tuple_example.b.c, r = range_example}
sort {-month}
take 12

# ── Standard library: math, text, date, and aggregation functions ──
let std_demo = (
  from products
  derive {
    abs_val = math.abs delta,
    rounded = math.round 2 price,
    ceiling = math.ceil price,
    floored = math.floor price,
    root = math.sqrt area,
    natural = math.ln price,
    base10 = math.log10 price,
    expo = math.exp 1,
    power = math.pow price 2,
    angle = math.sin (math.pi / 2) + math.cos 0 + math.tan 0 + math.asin 1 + math.acos 1 + math.atan 1,
    lowered = text.lower name,
    uppered = text.upper name,
    trimmed = text.trim name,
    ltrimmed = text.ltrim name,
    rtrimmed = text.rtrim name,
    len = text.length name,
    sub = text.extract 1 3 name,
    replaced = text.replace "a" "b" name,
    starts = text.starts_with "AC" sku,
    has = text.contains "-" sku,
    ends = text.ends_with "01" sku,
    as_text = date.to_text "%Y-%m-%d" created_at,
    now_ts = date.to_text "%H:%M" @08:30,
  }
  aggregate {
    total = std.sum qty,
    mean = std.average qty,
    deviation = std.stddev qty,
    spread = std.variance qty,
    rows = std.count this,
    low = std.min qty,
    high = std.max qty,
    first_seen = std.min created_at,
    names = std.concat_array names,
  }
)

# ── Window functions: all ranking forms ──
from sales
group region (
  sort {-amount}
  window rows:..0 (
    derive {
      r = rank amount,
      rd = rank_dense amount,
      rn = row_number this,
      nt = ntile 4,
      cd = cume_dist,
      pr = percent_rank,
    }
  )
)

# ── Reading external data ──
from (read_csv "data/orders.csv")
from (read_parquet "data/orders.parquet")
from (read_json "data/orders.json")
from s"SELECT * FROM legacy_orders"
from invoices = main.invoices_table

# ── Inline sub-pipelines and parenthesised expressions ──
from orders
derive {
  total_with_tax = (total | inv.net),
  flagged = (status == "paid" && !is_test) || override,
  clamped = case [total < 0 => 0, total > 1000 => 1000, true => total],
  nested = (case [a => (b | text.upper), true => "n/a"]),
}
filter (placed_at | date.to_text "%Y" | in ["2025", "2026"])

# ── Types, defaults and annotations ──
let with_types = (x <int> y <float> z <text> -> x)
let default_type = ratio <float> = 0.5
let bool_fn = (flag <bool> -> case [flag => 1, true => 0])
let array_type = (xs <array> -> xs)
let rel_fn = (rel <relation> -> (rel | take 5))
let t_fn = (x <int || float> -> x)

# ── Tuples, arrays and lookups ──
let nested_tuple = {a = 1, b = {c = [1, 2, 3], d = {e = "deep"}}}
let arr = [[1, 2], [3, 4], []]
let leading_comma_free = [1, 2, 3]
from orders
select {id, deep = nested_tuple.b.d.e}
derive {first_item = arr.0}

# ── Aliases, operators and precedence ──
from t
derive {
  a = 1 + 2 * 3 - 4 / 2 // 3 % 2,
  b = 2 ** 3 ** 2,
  c = -x + +y,
  d = x == y && x != z || x >= 1 && x <= 5 && x > 0 && x < 9,
  e = !flag,
  f = x ?? y ?? z,
  g = name ~= "regex",
  h = [1, 2] | array.contains 1,
}
derive e2 = 1
derive {a = 1}

# ── Date and time literals ──
from events
filter (created_at >= @2026-01-01T00:00:00Z && created_at < @2026-12-31T23:59:59.999Z)
filter (day == @2026-02-28 || at == @23:59 || at == @23:59:59.5)
derive {window_end = start + 90days - 1minutes + 2hours, gap = end - start}
