//- Pug 3.0 — syntax showcase
//- ── Comments ──
//- Pug showcase: warehouse stock page. This comment is NOT rendered.
//- TODO: paginate the table. FIXME: escape the footer HTML.
// This comment IS rendered into the HTML output.
//
  A block comment: everything indented below
  belongs to the comment and is rendered.
//-
  An unbuffered block comment.
  Nothing here is output.

//- ── Doctype, include, extends ──
doctype html
//- doctype xml / strict / transitional / custom: doctype html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
include helpers/mixins.pug
include:markdown-it ../docs/intro.md
include styles.css
extends layout.pug

//- ── Code: unbuffered, buffered, escaped, unescaped ──
-
  var warehouse = { name: "North <Depot>", open: true }
  var items = [
    { sku: "AC-1001", qty: 25, price: 19.99, tags: ["new", "sale"] },
    { sku: "AC-1002", qty: 0, price: 5, tags: [] },
  ]
- var total = items.reduce((s, i) => s + i.qty * i.price, 0)
- var title = `Stock for ${warehouse.name}`
- var re = /^AC-\d{4}$/i
- var n = 0x1F + 1_000 + 3.14e2

block head
  meta(charset="utf-8")
  meta(name="viewport" content="width=device-width, initial-scale=1")
  title= title
  link(rel="stylesheet" href="/stock.css")
  style.
    .low { color: #c33; }
    .ok  { color: #0a5; }
  script(src="/app.js" defer)
  script.
    window.__STOCK__ = !{JSON.stringify(items)};
    console.log("loaded", #{items.length}, 'items');

block content
  //- ── Tags, ids, classes, attributes ──
  h1#main-title.title.big(data-warehouse=warehouse.name) Stock for #{warehouse.name}
  .container
    #sidebar.panel
    p.
      A text block using the dot syntax. Interpolation works: #{total.toFixed(2)}
      and so does escaped \#{notInterpolated} and unescaped !{'<b>bold</b>'}.
      Tag interpolation: #[strong bold] and #[a(href="/x") a link] inside text.
    p
      | Piped text line one
      | and line two, with a trailing space.
      br
      | Then #[em emphasis].
    a(href="/stock?sku=AC-1001&qty=25" target="_blank" rel="noopener") Details
    a(href='/single-quoted' title="Mixed \"escapes\" here") Link
    input(type="checkbox" checked)
    input(type="text" name="sku" value=items[0].sku disabled=false required)
    input(type='checkbox', checked=true, class='a b c')
    button(type="button" onclick="alert('hi')" class={ active: warehouse.open, hidden: !warehouse.open }) Go
    div(class="a" class=["b", "c"] style={ color: "red", "font-size": "12px" })
    div(style="color: red;" data-json=JSON.stringify(items[0]))
    div&attributes({ id: "spread", "data-x": 1 })
    img(src="logo.png" alt="Logo")/
    foo: bar: baz Nested inline tags with the colon shorthand
    ul: li One
    p= 'Buffered code: ' + warehouse.name
    p!= '<em>Unescaped code</em>'
    p #{'escaped <>'} and !{'<i>raw</i>'}
    textarea
      | Preformatted
      |   spaces stay

  //- ── Conditionals ──
  if items.length === 0
    p.muted No items.
  else if items.length < 3
    p Few items: #{items.length}
  else
    p Many items.

  unless warehouse.open
    p Closed

  case items.length
    when 0
      p none
    when 1
    when 2
      p few
    when 3: p three
    default
      p many

  //- ── Iteration ──
  table.stock
    thead
      tr
        th SKU
        th Qty
        th Price
        th Tags
    tbody
      each item, i in items
        tr(class=i % 2 ? "odd" : "even")
          td= item.sku
          td(class=item.qty === 0 ? "low" : "ok")= item.qty
          td $#{item.price.toFixed(2)}
          td
            each tag in item.tags
              span.tag= tag
            else
              em no tags
      else
        tr: td(colspan=4) Empty

  each val, key in { a: 1, b: 2 }
    li #{key}: #{val}

  - var k = 0
  while k < 3
    li= k++

  for item in items
    p= item.sku

  //- ── Mixins ──
  mixin badge(status)
    span.badge(class=status === 'paid' ? 'ok' : 'muted')&attributes(attributes)= status

  mixin card(title, ...rest)
    .card
      h2= title
      if block
        block
      else
        p No content
      ul
        each r in rest
          li= r

  mixin price(value, currency = "USD")
    span.price #{currency} #{value.toFixed(2)}

  +badge('paid')
  +badge('open')(class="extra" data-id="1")
  +card('Widget', 'one', 'two')
    p Block passed to the mixin
  +price(19.99)
  +price(5, "EUR")
  +#{mixinName}(1)

  //- ── Filters ──
  :markdown-it
    # Heading inside a filter
    * list item
    * another
  :scss
    $c: red;
    .x { color: $c; }
  :cdata
    raw <data>

  //- ── Blocks, append, prepend ──
  block append scripts
    script(src="/extra.js")
  block prepend styles
    link(rel="stylesheet" href="/extra.css")

  //- ── Attributes: every spelling ──
  a(href="/" + path) Concatenated
  a(href=`/stock/${items[0].sku}`) Template literal
  a(href="/a",
    title="multi-line attributes",
    class="x"
  ) Multi-line attribute list
  div(data-x!="<b>unescaped</b>")
  div(data-y="<b>escaped</b>")
  div(class="a b", id="ident")
  input(type="radio", name="r", value="1", checked)
  input(type="radio" name="r" value="2" checked=false)
  option(selected=true) Yes
  option(selected=false) No
  div(aria-label='single' data-empty="" data-null=null data-undef=undefined data-num=42)
  div(@click="handler" :class="{ a: b }" v-bind:id="x" v-on:click.prevent="go" #default="{ item }") Framework attributes
  div(data-a=1 data-b=2 data-c=3)
  div(class=["a", { b: true, c: false }] id=`id-${n}`)
  .shorthand-class
  #shorthand-id
  .a.b.c#d(e="f") Mixed shorthand
  a.btn.btn-primary(href="/x") Link with classes
  p(class="one two").three Combined class forms

  //- ── Tag forms ──
  br
  hr/
  img(src="a.png")/
  custom-element(some-prop="x") Custom element names
  svg:path(d="M0 0L10 10")
  p Text on the same line as the tag
  p.
    Block text with dot
      preserving relative indentation.
  p
    | Piped text
    |  with a leading space preserved
    |
    | after an empty pipe line
  <div class="literal-html">Raw HTML line, passed through</div>
  <p>
    Multi-line literal HTML
  </p>
  span: a(href="#") Block expansion with colon
  li: a: span Deeper block expansion
  p
    | Text with an inline tag
    = " "
    strong Bold
    |  and the rest.
  p Interpolation: #{items[0].sku}, escaped \#{no}, raw !{"<b>b</b>"}, tags #[b bold] #[a(href="/") x] #[+badge('paid')]
  p= items[0].sku.toUpperCase()
  p!= "<b>unescaped buffered</b>"
  = items.length
  != "<hr>"

  //- ── Unbuffered code in every form ──
  - var a = 1, b = 2
  - const list = [1, 2, 3]
  - let fn = (x) => x * 2
  - function helper(x) { return x + 1 }
  -
    var multi = {
      line: true
    }
  - for (var i = 0; i < 3; i++)
    li= i
  - items.forEach(function (item) {
    p= item.sku
  - })
  - if (a > b) { b = a }

  //- ── Extra control flow ──
  case warehouse.name
    when "North": p North
    when "South"
      p South
    default: p Other
  if warehouse.open
    p Open
  else if warehouse.closed
    p Closed
  else
    p Unknown
  unless items.length
    p None
  each v, idx in [10, 20, 30]
    li #{idx}: #{v}
  each v in []
    li never
  else
    li empty
  while k > 0
    - k--
    li= k

  //- ── Mixins: advanced forms ──
  mixin list(items)
    ul
      each i in items
        li= i
  mixin nested-block
    .wrap
      block
  mixin with-attrs
    div&attributes(attributes)
      block
  mixin defaults(a = 1, b = "two", {c, d} = {}, ...rest)
    p= a + b
  +list(['a', 'b'])
  +nested-block
    p Inside
  +with-attrs(class="from-call" id="x")
    | content
  +defaults(1, "x", {c: 3, d: 4}, 'extra1', 'extra2')
  +with-attrs.class-literal#id-literal(data-x="1") Text after call
  +list(items.map(function (i) { return i.sku }))

  //- ── Includes and blocks ──
  include partials/header.pug
  include:markdown-it:highlight partials/readme.md
  include /abs/path/file.js
  include ../shared/footer
  block scripts
    script(src="/a.js")
  block append scripts
    script(src="/b.js")
  block prepend styles
    link(rel="stylesheet" href="/c.css")
  append head
    meta(name="x" content="y")
  prepend head
    meta(name="z" content="w")

  //- ── Script, style and raw text elements ──
  script(type="text/template").
    <div>{{ name }}</div>
  script(type="application/json")!= JSON.stringify(items)
  script.
    var plain = "javascript";
    if (a < b && c > d) { go(); }
  style(media="print").
    body { color: black; }
  pre
    code.
      line 1
        indented line 2
  textarea(rows=3)= "prefilled"
  title Page #{title}
  - var html = "<p>raw</p>"
  div!= html
  div= html

  //- ── Whitespace and comments ──
  //
    Block comment containing
    multiple lines.
  // single rendered comment
  //- unrendered comment
  //-
    unrendered block
  p text
  //- IE conditional comment in raw html:
  <!--[if lt IE 9]>
  <p>Old browser</p>
  <![endif]-->

footer
  | &copy; #{new Date().getFullYear()} Example Ltd
  != footerHtml
  = ' '
  a(href="mailto:support@example.com") support@example.com
