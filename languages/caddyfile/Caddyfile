# Global options, every common one
{
	debug
	http_port 8080
	https_port 8443
	default_bind 192.0.2.1
	grace_period 10s
	shutdown_delay 5s
	auto_https off
	auto_https ignore_loaded_certs
	skip_install_trust
	local_certs
	renew_interval 30m
	ocsp_interval 12h
	ocsp_stapling off
	key_type ed25519
	cert_issuer acme {
		dir https://acme.example.com/directory
		email ops@example.com
	}
	acme_dns cloudflare {env.CF_API_TOKEN}
	acme_eab {
		key_id example-key-id
		mac_key example-not-a-real-key
	}
	on_demand_tls {
		ask http://localhost:9123/check
		interval 2m
		burst 5
	}
	storage_clean_interval 24h
	log default {
		output stderr
		format console
		level WARN
		include http.log.access admin.api
		exclude http.log.access.static
	}
	servers :443 {
		name https
		listener_wrappers {
			proxy_protocol
			tls
		}
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
		strict_sni_host insecure_off
		metrics
		trace
	}
	pki {
		ca internal {
			root_cn "Example Root"
		}
	}
	events {
		on cert_obtained exec ./notify.sh
	}
	cert_lifetime 24h
	ech example.com
	dns cloudflare {env.CF_API_TOKEN}
}

# Imports with arguments and snippet reuse
(cors) {
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Origin {args[0]}
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		respond "" 204
	}
}
(common) {
	encode zstd gzip
	{block}
}
import cors https://app.example.com
import common {
	respond "inside block"
}
