{% extends "layouts/base.njk" %}
{% import "macros/forms.njk" as forms %}
{% from "macros/ui.njk" import button, badge as tag with context %}

{% set title = user.name + " — Orders" %}
{% set total = 0 %}
{% set a, b = 1, 2 %}
{% set captured %}
  Block-captured text with {{ title }}.
{% endset %}

{% macro money(n, currency="GBP", precision=2) %}{{ n | currency(currency) }}{% endmacro %}

{% macro row(order, highlight=false) %}
  <tr class="{{ 'paid' if order.paid else 'open' }}{{ ' hot' if highlight }}">
    <td>#{{ order.number }}</td>
    <td>{{ money(order.total, currency="EUR") }}</td>
    <td>{{ caller() if caller else "" }}</td>
  </tr>
{% endmacro %}

{% call row(order) %}Nested call body{% endcall %}

{% block content %}
  <h1>Orders for {{ user.name | title }}</h1>

