  {{ d | dictsort }} {{ n | float }} {{ n | int }} {{ s | nl2br }} {{ s | center(20) }} {{ s | indent(2, true) }}

  {# ── Conditionals ── #}
  {% if orders | length == 0 %}
    <p class="muted">No orders yet.</p>
  {% elif orders | length < 5 %}
    <p>A few orders.</p>
  {% elseif orders | length < 50 %}
    <p>Plenty.</p>
  {% else %}
    <table>
      {# ── Loops ── #}
      {% for order in orders | sort(true, false, "placedAt") %}
        {{ row(order, loop.first) }}
        {% if loop.first %}<td><span class="badge">latest</span></td>{% endif %}
        {% if loop.last %}last{% endif %}
        <td>{{ loop.index }} {{ loop.index0 }} {{ loop.revindex }} {{ loop.revindex0 }} {{ loop.length }}</td>
        {% set total = total + order.total %}
      {% else %}
        <tr><td>Empty loop</td></tr>
      {% endfor %}
      {% for key, value in config %}{{ key }}={{ value }}{% endfor %}
      {% for x, y, z in triples %}{{ x }}{{ y }}{{ z }}{% endfor %}
      {% asyncEach item in items %}{{ item }}{% endeach %}
      {% asyncAll item in items %}{{ item }}{% endall %}
    </table>
  {% endif %}

  {# ── Includes and raw ── #}
  {% include "partials/pagination.njk" %}
  {% include "partials/optional.njk" ignore missing %}
  {% include "partials/ctx.njk" ignore missing with context %}
  {% raw %}{{ this is not rendered }} {% not a tag %}{% endraw %}
  {% verbatim %}{{ also literal }}{% endverbatim %}

  {# ── Filter block and whitespace control ── #}
  {% filter upper %}shout this{% endfilter %}
  {%- if flag -%}
    trimmed on both sides
  {%- endif -%}
  {{- title -}}
  {% switch status %}
    {% case "paid" %}Paid
    {% case "open" %}Open
    {% default %}Unknown
  {% endswitch %}

  <script>
    window.__DATA__ = {{ orders | dump | safe }};
  </script>
  <style>.paid { color: green; }</style>
  {{ footerHtml | safe }}
{% endblock %}

{% block footer %}
  {{ super() }}
  <p>Total: {{ money(total) }}</p>
  {% if forms.valid %}{{ forms.input("email", type="email") }}{% endif %}
{% endblock footer %}

