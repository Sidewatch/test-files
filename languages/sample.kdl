// KDL: a service definition with nested nodes and typed values.
service "inventory-api" version="1.4.0" {
    replicas 3
    ports 8080 9090
    debug #false

    database {
        host "db.internal"
        port 5432
        ssl #true
        timeout (seconds)30
    }

    env {
        LOG_LEVEL "info"
        FEATURE_FLAGS "search,export"
    }

    /- disabled-node "this whole node is commented out"

    healthcheck path="/healthz" interval="10s" {
        expect status=200
    }
}
