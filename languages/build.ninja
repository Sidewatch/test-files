# Ninja: a hand-written build for a two-file C program.
ninja_required_version = 1.10

cc = cc
cflags = -O2 -Wall -std=c11
builddir = build

rule cc
  command = $cc $cflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC $out

rule link
  command = $cc $in -o $out -lsqlite3
  description = LINK $out

build $builddir/stock.o: cc src/stock.c
build $builddir/main.o: cc src/main.c
  cflags = $cflags -DVERSION="1.4.0"

build $builddir/inventory: link $builddir/stock.o $builddir/main.o

default $builddir/inventory
