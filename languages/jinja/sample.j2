{# ── Ansible-style YAML embedding ── #}
- name: Deploy {{ app_name | default('inventory') }}
  ansible.builtin.template:
    src: "{{ role_path }}/templates/app.conf.j2"
    dest: "/etc/{{ app_name }}/app.conf"
    mode: "0644"
  when: ansible_os_family == "Debian" and inventory_hostname in groups['warehouse']
  vars:
    api_url: "https://api.example.com/{{ version }}"
    addr: "{{ ansible_default_ipv4.address | default('192.0.2.10') }}"

