{# ── Control flow ── #}
{% if count > 100 %}
  big
{% elif count > 10 %}
  medium
{% else %}
  small
{% endif %}

{% for item in items | default([]) if not item.discontinued %}
  {%- set ns.total = ns.total + item.qty -%}
  <tr class="{{ loop.cycle('odd', 'even') }}{% if loop.first %} first{% endif %}{% if loop.last %} last{% endif %}">
    <td>{{ loop.index }}/{{ loop.length }} (rev {{ loop.revindex }}, idx0 {{ loop.index0 }}, rev0 {{ loop.revindex0 }})</td>
    <td>{{ item.sku }}{{ loop.previtem.sku if loop.previtem }}{{ loop.nextitem.sku if loop.nextitem }}</td>
    <td>{{ item["qty"] | default(0) }} {% if loop.changed(item.category) %}new category{% endif %}</td>
    {% if item.qty == 0 %}{% continue %}{% endif %}
    {% if ns.total > 1000 %}{% break %}{% endif %}
  </tr>
{% else %}
  <tr><td colspan="3">No stock</td></tr>
{% endfor %}

{% for key, value in dict_lit | dictsort %}
  {{ key }}={{ value }}
{% endfor %}

{% for row in matrix recursive %}
  {{ row.name }}{% if row.children %}<ul>{{ loop(row.children) }}</ul>{% endif %}
{% endfor %}

{# ── Macros and call blocks ── #}
{% macro field(name, value="", type="text", required=false, **attrs) -%}
  <input type="{{ type }}" name="{{ name }}" value="{{ value | e }}"
         {%- if required %} required{% endif %}
         {%- for k, v in attrs.items() %} {{ k }}="{{ v }}"{% endfor %}>
{%- endmacro %}

{% macro dialog(title) %}
  <div class="dialog"><h2>{{ title }}</h2>{{ caller() }}</div>
{% endmacro %}

{% call dialog("Confirm shipment") %}
  Ship {{ count }} units from {{ site }}?
{% endcall %}

{% call(user) render_list(users) %}
  {{ user.name }}
{% endcall %}

{{ field("sku", "A-100", required=true, class="wide", data_id=7) }}
{{ forms.input("qty", 5) }}

{# ── Filter blocks, raw, with, autoescape ── #}
{% filter upper | trim %}
  shouting text for {{ site }}
{% endfilter %}

{% raw %}
  {{ not rendered }} {% also not rendered %} {# nor this #}
{% endraw %}

{% with local = count * 2, other = "scoped" %}
  {{ local }} {{ other }}
{% endwith %}

{% autoescape true %}{{ "<b>escaped</b>" }}{% endautoescape %}
{% autoescape false %}{{ "<b>raw</b>" }}{% endautoescape %}

{% trans count=count %}
  One item in {{ site }}.
{% pluralize %}
  {{ count }} items in {{ site }}.
{% endtrans %}

{% do ns.seen.append(site) %}
{% debug %}

