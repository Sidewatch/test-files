{% extends "base/warehouse.html.j2" %}
{% import "macros/forms.j2" as forms %}
{% from "macros/tables.j2" import render_row, render_header as header with context %}
{% include "partials/banner.j2" ignore missing without context %}

{% block title %}Inventory for {{ warehouse.name | title }}{% endblock title %}

{% block head %}
  {{ super() }}
  <meta name="generator" content="Acme Reports {{ version }}">
{% endblock %}

