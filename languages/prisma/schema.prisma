// ── Comments ──
// Prisma schema for a warehouse inventory system.
// Line comment. TODO: add soft deletes. FIXME: index the audit trail.

/// Triple-slash comments are doc comments attached to the next block or field.
/// They appear in the generated client's documentation.

// ── Generators and datasources ──
generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["fullTextSearchPostgres", "views", "multiSchema"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  engineType      = "library"
}

generator erd {
  provider = "prisma-erd-generator"
  theme    = "neutral"
  disabled = false
  ratio    = 1.5
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "audit"]
  extensions = [pg_trgm, pgcrypto(schema: "public")]
}

// ── Enums ──
/// Lifecycle of an order.
enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  CANCELLED @map("cancelled")

  @@map("order_status")
  @@schema("public")
}

enum Role {
  USER
  PICKER
  MANAGER
  ADMIN
}

// ── Composite types (MongoDB-style) ──
type Dimensions {
  width  Float
  height Float
  depth  Float
  unit   String @default("cm")
}

// ── Models ──
/// A physical warehouse.
model Warehouse {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(8)
  name      String
  address   String?
  latitude  Decimal?  @db.Decimal(9, 6)
  longitude Decimal?  @db.Decimal(9, 6)
  bins      Bin[]
  staff     Staff[]   @relation("WarehouseStaff")
  opened    DateTime  @default(now()) @db.Timestamptz(3)
  closed    DateTime?

  @@map("warehouses")
  @@schema("public")
}

model Bin {
  id          Int       @id @default(autoincrement())
  label       String    @db.Char(6)
  aisle       Int       @db.SmallInt
  shelf       Int       @db.SmallInt
  capacity    Int       @default(100)
  warehouseId Int       @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  stock       StockLevel[]

  @@unique([warehouseId, label], name: "bin_label", map: "bin_label_key")
  @@index([aisle, shelf], type: Hash)
  @@map("bins")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique @db.VarChar(32)
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  weightGrams Int      @default(0)
  active      Boolean  @default(true)
  tags        String[]
  attributes  Json     @default("{}")
  photo       Bytes?
  barcode     BigInt?  @unique
  rating      Float    @default(0.0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  token       String   @default(cuid())
  slug        String   @default(dbgenerated("gen_random_uuid()"))
  nano        String   @default(nanoid(8))
  stock       StockLevel[]
  lines       OrderLine[]
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  supplierId  Int?

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@fulltext([name, description])
  @@map("products")
}

model StockLevel {
  productId String  @map("product_id") @db.Uuid
  binId     Int     @map("bin_id")
  quantity  Int     @default(0)
  reserved  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
  bin       Bin     @relation(fields: [binId], references: [id])

  @@id([productId, binId])
  @@index([quantity(sort: Desc)])
  @@ignore
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  email    String?   @db.VarChar(254)
  rating   Int?
  products Product[]
}

model Order {
  id          Int         @id @default(autoincrement())
  number      String      @unique @default(uuid())
  status      OrderStatus @default(PENDING)
  placedAt    DateTime    @default(now()) @map("placed_at")
  total       Decimal     @db.Decimal(12, 2)
  customer    Customer    @relation(fields: [customerId], references: [id])
  customerId  Int
  lines       OrderLine[]
  notes       String?
  packedBy    Staff?      @relation("PackedBy", fields: [packedById], references: [id])
  packedById  Int?
  approvedBy  Staff?      @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById Int?

  @@index([customerId, status])
  @@map("orders")
}

model OrderLine {
  orderId   Int
  productId String   @db.Uuid
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
}

model Customer {
  id     Int     @id @default(autoincrement())
  email  String  @unique
  name   String?
  orders Order[]
  tier   Int     @default(1)
}

model Staff {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  role        Role       @default(PICKER)
  warehouse   Warehouse  @relation("WarehouseStaff", fields: [warehouseId], references: [id])
  warehouseId Int
  packed      Order[]    @relation("PackedBy")
  approved    Order[]    @relation("ApprovedBy")
  manager     Staff?     @relation("Reports", fields: [managerId], references: [id])
  managerId   Int?
  reports     Staff[]    @relation("Reports")
  unsupported Unsupported("point")?
  dims        Dimensions?
}

/// An audit trail kept in a second schema.
model AuditEntry {
  id      BigInt   @id @default(autoincrement())
  actor   String
  action  String
  at      DateTime @default(now())
  payload Json?

  @@map("audit_log")
  @@schema("audit")
}

// ── Views ──
view LowStock {
  sku      String @unique
  name     String
  quantity Int

  @@map("low_stock")
}

// ── Attribute argument forms: strings, escapes, numbers, booleans, lists, functions ──
model Literals {
  id     Int     @id
  a      String  @default("tab\there \"quoted\" \\ back é unicode \n")
  b      Int     @default(-42)
  c      Float   @default(1.5e3)
  d      Boolean @default(false)
  e      Boolean @default(true)
  f      String  @default(env("DEFAULT_LABEL"))
  g      Json    @default("{\"sku\": \"AC-1001\", \"qty\": [1, 2, 3]}")
  h      Int[]   @default([1, 2, 3])
  i      DateTime @default(now())
  j      Decimal @default(0.00)

  @@index([a, b(sort: Asc, length: 10)], map: "literals_idx", name: "literals_name")
}
