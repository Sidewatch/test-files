// Prisma ORM 6 — schema syntax showcase
// ── Comments ──
// Prisma schema for a warehouse inventory system.
// Line comment. TODO: add soft deletes. FIXME: index the audit trail.

/// Triple-slash comments are doc comments attached to the next block or field.
/// They appear in the generated client's documentation.

// ── Generators and datasources ──
generator esm {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  previewFeatures        = ["postgresqlExtensions", "relationJoins", "typedSql", "queryCompiler", "driverAdapters", "omitApi", "nativeDistinct", "strictUndefinedChecks"]
}

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["fullTextSearchPostgres", "views", "multiSchema"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  engineType      = "library"
}

generator erd {
  provider = "prisma-erd-generator"
  theme    = "neutral"
  disabled = false
  ratio    = 1.5
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "audit"]
  extensions = [pg_trgm, pgcrypto(schema: "public")]
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  relationMode = "foreignKeys"
}

// ── Enums ──
/// Lifecycle of an order.
enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  CANCELLED @map("cancelled")

  @@map("order_status")
  @@schema("public")
}

enum Role {
  USER
  PICKER
  MANAGER
  ADMIN
}

// ── Composite types (MongoDB-style) ──
type Dimensions {
  width  Float
  height Float
  depth  Float
  unit   String @default("cm")
}

// ── Models ──
/// A physical warehouse.
model Warehouse {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(8)
  name      String
  address   String?
  latitude  Decimal?  @db.Decimal(9, 6)
  longitude Decimal?  @db.Decimal(9, 6)
  bins      Bin[]
  staff     Staff[]   @relation("WarehouseStaff")
  opened    DateTime  @default(now()) @db.Timestamptz(3)
  closed    DateTime?

  @@map("warehouses")
  @@schema("public")
}

model Bin {
  id          Int       @id @default(autoincrement())
  label       String    @db.Char(6)
  aisle       Int       @db.SmallInt
  shelf       Int       @db.SmallInt
  capacity    Int       @default(100)
  warehouseId Int       @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  stock       StockLevel[]

  @@unique([warehouseId, label], name: "bin_label", map: "bin_label_key")
  @@index([aisle, shelf], type: Hash)
  @@map("bins")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique @db.VarChar(32)
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  weightGrams Int      @default(0)
  active      Boolean  @default(true)
  tags        String[]
  attributes  Json     @default("{}")
  photo       Bytes?
  barcode     BigInt?  @unique
  rating      Float    @default(0.0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  token       String   @default(cuid())
  slug        String   @default(dbgenerated("gen_random_uuid()"))
  nano        String   @default(nanoid(8))
  stock       StockLevel[]
  lines       OrderLine[]
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  supplierId  Int?

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@fulltext([name, description])
  @@map("products")
}

model StockLevel {
  productId String  @map("product_id") @db.Uuid
  binId     Int     @map("bin_id")
  quantity  Int     @default(0)
  reserved  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
  bin       Bin     @relation(fields: [binId], references: [id])

  @@id([productId, binId])
  @@index([quantity(sort: Desc)])
  @@ignore
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  email    String?   @db.VarChar(254)
  rating   Int?
  products Product[]
}

model Order {
  id          Int         @id @default(autoincrement())
  number      String      @unique @default(uuid())
  status      OrderStatus @default(PENDING)
  placedAt    DateTime    @default(now()) @map("placed_at")
  total       Decimal     @db.Decimal(12, 2)
  customer    Customer    @relation(fields: [customerId], references: [id])
  customerId  Int
  lines       OrderLine[]
  notes       String?
  packedBy    Staff?      @relation("PackedBy", fields: [packedById], references: [id])
  packedById  Int?
  approvedBy  Staff?      @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById Int?

  @@index([customerId, status])
  @@map("orders")
}

model OrderLine {
  orderId   Int
  productId String   @db.Uuid
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
}

model Customer {
  id     Int     @id @default(autoincrement())
  email  String  @unique
  name   String?
  orders Order[]
  tier   Int     @default(1)
}

model Staff {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  role        Role       @default(PICKER)
  warehouse   Warehouse  @relation("WarehouseStaff", fields: [warehouseId], references: [id])
  warehouseId Int
  packed      Order[]    @relation("PackedBy")
  approved    Order[]    @relation("ApprovedBy")
  manager     Staff?     @relation("Reports", fields: [managerId], references: [id])
  managerId   Int?
  reports     Staff[]    @relation("Reports")
  unsupported Unsupported("point")?
  dims        Dimensions?
}

/// An audit trail kept in a second schema.
model AuditEntry {
  id      BigInt   @id @default(autoincrement())
  actor   String
  action  String
  at      DateTime @default(now())
  payload Json?

  @@map("audit_log")
  @@schema("audit")
}

// ── Views ──
view LowStock {
  sku      String @unique
  name     String
  quantity Int

  @@map("low_stock")
}

// ── Attribute argument forms: strings, escapes, numbers, booleans, lists, functions ──
model Literals {
  id     Int     @id
  a      String  @default("tab\there \"quoted\" \\ back é unicode \n")
  b      Int     @default(-42)
  c      Float   @default(1.5e3)
  d      Boolean @default(false)
  e      Boolean @default(true)
  f      String  @default(env("DEFAULT_LABEL"))
  g      Json    @default("{\"sku\": \"AC-1001\", \"qty\": [1, 2, 3]}")
  h      Int[]   @default([1, 2, 3])
  i      DateTime @default(now())
  j      Decimal @default(0.00)

  @@index([a, b(sort: Asc, length: 10)], map: "literals_idx", name: "literals_name")
}

// ── Every field type, modifier and native type ──
model Everything {
  id         Int       @id @default(autoincrement())
  bigId      BigInt    @default(autoincrement())
  seq        Int       @default(sequence(minValue: 1, maxValue: 9999, start: 1, increment: 1, cache: 10))
  str        String
  strOpt     String?
  strList    String[]
  bool       Boolean
  intVal     Int
  floatVal   Float
  decimalVal Decimal
  dateTime   DateTime
  json       Json
  bytes      Bytes
  bigInt     BigInt
  enumVal    Role      @default(USER)
  enumList   Role[]
  uuid4      String    @default(uuid(4))
  uuid7      String    @default(uuid(7))
  cuid1      String    @default(cuid(1))
  cuid2      String    @default(cuid(2))
  ulid       String    @default(ulid())
  nano       String    @default(nanoid())
  dbGen      String    @default(dbgenerated())
  dbGenExpr  Int       @default(dbgenerated("1 + 1"))
  now        DateTime  @default(now())
  updated    DateTime  @updatedAt
  text       String    @db.Text
  vc         String    @db.VarChar(255)
  ch         String    @db.Char(2)
  citext     String    @db.Citext
  xml        String    @db.Xml
  inet       String    @db.Inet
  bit        String    @db.Bit(8)
  varbit     String    @db.VarBit(8)
  money      Decimal   @db.Money
  small      Int       @db.SmallInt
  oid        Int       @db.Oid
  real       Float     @db.Real
  double     Float     @db.DoublePrecision
  dec        Decimal   @db.Decimal(20, 6)
  date       DateTime  @db.Date
  time       DateTime  @db.Time(6)
  timetz     DateTime  @db.Timetz(6)
  ts         DateTime  @db.Timestamp(6)
  tstz       DateTime  @db.Timestamptz(6)
  jsonb      Json      @db.JsonB
  jsonPlain  Json      @db.Json
  bin        Bytes     @db.ByteA
  uid        String    @db.Uuid
  geo        Unsupported("geometry(Point, 4326)")?
  tsv        Unsupported("tsvector")?

  @@id([id], map: "everything_pkey", length: 8, sort: Asc, clustered: false)
  @@unique([str, intVal], name: "str_int", map: "str_int_key", length: 10, sort: Desc, clustered: false)
  @@index([dateTime(sort: Desc), floatVal], map: "dt_idx", type: Brin)
  @@index([json(ops: JsonbPathOps)], type: Gin)
  @@index([str(ops: raw("gist_trgm_ops(siglen=32)"))], type: Gist)
  @@index([intVal], type: SpGist)
  @@index([bool], where: raw("bool = true"))
  @@fulltext([str, text], map: "ft")
  @@map("everything")
  @@schema("public")
}

// ── Relations: every shape and referential action ──
model Parent {
  id       Int      @id
  children Child[]
  one      OneToOne?
  m2m      Tag[]
  explicit TagOnParent[]
}

model Child {
  id        Int    @id
  parentId  Int
  parent    Parent @relation(fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "child_parent_fk")
  altId     Int?
  alt       Parent? @relation("Alt", fields: [altId], references: [id], onDelete: SetDefault, onUpdate: SetNull)
  other     Parent? @relation(name: "Other", fields: [otherId], references: [id], onDelete: Restrict)
  otherId   Int?
}

model OneToOne {
  id       Int    @id
  parentId Int    @unique
  parent   Parent @relation(fields: [parentId], references: [id])
}

model Tag {
  id      Int      @id
  parents Parent[]
}

model TagOnParent {
  parentId Int
  tagId    Int
  parent   Parent @relation(fields: [parentId], references: [id])
  @@id([parentId, tagId])
}

// ── MongoDB-style models and composite types ──
type Address {
  street String
  city   String
  geo    Geo?
  tags   String[]
}

type Geo {
  lat Float
  lng Float
}

model MongoUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  address   Address
  history   Address[]
  refId     String   @db.ObjectId
  createdAt DateTime @default(now()) @db.Date
  meta      Json?
  @@map("mongo_users")
}

// ── Comments in odd places ──
model Commented { // trailing comment on the block line
  id Int @id // trailing comment on a field
  /// doc comment on a field
  name String
  // standalone comment inside a block
  @@map("commented") // trailing comment on an attribute
}

