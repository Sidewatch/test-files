// ── Remaining expressions and statements ───────────────────
fn extras() {
	a := Item{ sku: 'A' }
	b := Item{
		...a
		qty: 5
	}
	anon := struct {
		x int
		y int
	}{ 1, 2 }
	mut sorted := [3, 1, 2]
	sorted.sort(a < b)
	sorted.sort_with_compare(fn (a &int, b &int) int {
		return *a - *b
	})
	nested := [[1, 2], [3, 4]]
	strs := ['a', 'b'].map(it.to_upper())
	any_big := sorted.any(it > 2)
	all_pos := sorted.all(it > 0)
	idx := sorted.index(2)
	first := sorted.first()
	rev := sorted.reverse()
	cloned := sorted.clone()
	joined := strs.join(', ')
	pos := sorted.filter(it > 0).map(it * 2)
	str_len := 'héllo'.len
	ch := 'héllo'[1]
	sub := 'hello'[1..3]
	c_ptr := voidptr(0)
	null_ptr := unsafe { nil }
	size := sizeof(Item)
	tname := typeof(a).name
	off := __offsetof(Item, qty)
	is_ref := isreftype(Item)
	dumped := dump(size)
	likely_ok := likely(size > 0)
	unlikely_ok := unlikely(size < 0)
	vptr := &Item(0)
	arr_ptr := &[]int{}
	fixed2 := [2][3]int{}
	chan_ := chan int{}
	atomic_n := 0
	mut sh := shared []int{}
	typ := i8(1) + i16(2) + i32(3) + i64(4) + u8(5) + u16(6) + u32(7) + u64(8) + isize(9) + usize(10) + f32(1.5) + f64(2.5)
	r := rune(0x263A)
	bs := byte(65)
	ok := bool(true)
	s := string('x')
	sym := voidptr(c_ptr)
	mut m := map[string][]int{}
	m['k'] << 1
	delete_key := m.delete('k')
	$if debug {
		println('debug build')
	}
	asm amd64 {
		mov eax, 1
		; =r (atomic_n)
	}
	_ = [b, anon, nested, any_big, all_pos, idx, first, rev, cloned, joined, pos, str_len, ch, sub, null_ptr, tname, off, is_ref, dumped, likely_ok, unlikely_ok, vptr, arr_ptr, fixed2, chan_, typ, r, bs, ok, s, sym, delete_key, sh]
}

// ── Embedded SQL (orm) ─────────────────────────────────────
struct User {
	id   int    @[primary; sql: serial]
	name string @[sql: 'user_name'; unique]
	age  int
}

fn orm(db orm.Connection) ! {
	sql db {
		create table User
	}!
	sql db {
		insert User{ name: 'acme', age: 30 } into User
	}!
	users := sql db {
		select from User where age > 18 && name != '' order by age desc limit 10 offset 2
	}!
	count := sql db {
		select count from User
	}!
	sql db {
		update User set age = 31 where name == 'acme'
	}!
	sql db {
		delete from User where id == 1
	}!
	sql db {
		drop table User
	}!
	_ = [users.len, count]
}

// ── Interfaces, embedding and visibility ───────────────────
interface Shape {
	area() f64
	name string
}

interface Named {
	Describer
	label() string
}

struct Circle {
pub:
	r f64
}

fn (c Circle) area() f64 {
	return math.pi * c.r * c.r
}

pub fn exported_fn() {}
pub const exported_const = 1
pub struct ExportedStruct {}
pub enum ExportedEnum {
	a
	b
}
pub type ExportedAlias = int
pub interface ExportedIface {}

