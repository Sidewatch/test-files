	static counter := 0
	counter++
	volatile_var := 0
	_ = volatile_var
}

fn generic_call() {
	_ := sum[int]([1, 2, 3])
	_ := Pair[int, string]{ first: 1, second: 'a' }
	_ := describe_type[string]('x')
}

fn error_types() ! {
	return error_with_code('failed', 42)
}

struct MyError {
	Error
	code int
}

fn (e MyError) msg() string {
	return 'my error'
}

fn (e MyError) code() int {
	return e.code
}

fn try_it() {
	x := error_types() or {
		println('error code ${err.code()}: ${err.msg()}')
		return
	}
	y := error_types() or { panic(err) }
	z := error_types() or { 0 }
	_ = [x, y, z]
}

