{{! ── Comments ── }}
{{! Short Handlebars comment: orders list. TODO: paginate. }}
{{!-- Long comment that may contain }} braces and {{mustaches}} safely. --}}
<!-- An HTML comment is passed through to the output. -->

{{!-- ── Expressions ── --}}
<h1>Orders for {{user.name}}</h1>
<p>{{user.address.city}} / {{user/address/postcode}} / {{../parent}} / {{this}} / {{this.name}} / {{./local}}</p>
<p>{{lookup names 0}} {{lookup user "name"}} {{array.[0]}} {{[odd key].value}} {{items.[10].sku}}</p>
<p>Unescaped: {{{footerHtml}}} and {{&ampersandHtml}}</p>
<p>Escaped mustache: \{{not-evaluated}} and \\{{evaluated-after-backslash}}</p>
<p>Data variables: {{@index}} {{@key}} {{@first}} {{@last}} {{@root.title}} {{@../index}} {{@level}}</p>

{{!-- ── Literals ── --}}
{{helper "double quoted" 'single quoted' "with \"escape\""}}
{{helper 42 -7 3.14 true false null undefined}}
{{helper key="value" count=3 flag=true nothing=null nested=(sub 1 2)}}
{{helper [segment literal] "mixed" 1.5e3}}

{{!-- ── Whitespace control ── --}}
<ul>
  {{~#each items~}}
    <li>{{~name~}}</li>
  {{~/each~}}
</ul>
{{~! comment with whitespace control ~}}
{{{~triple~}}}

{{!-- ── Conditionals ── --}}
{{#if orders.length}}
  <table class="orders">
    {{#each orders as |order index|}}
      <tr class="{{#if order.paid}}paid{{else}}open{{/if}}">
        <td>#{{order.number}}</td>
        <td>{{money order.total currency="GBP"}}</td>
        <td>{{formatDate order.placedAt "yyyy-MM-dd"}}</td>
        {{#if (eq index 0)}}<td><span class="badge">latest</span></td>{{/if}}
        {{#unless order.cancelled}}<td>active</td>{{/unless}}
      </tr>
    {{/each}}
  </table>
  {{> pagination page=page total=pages}}
{{else if archived}}
  <p>Archived orders only.</p>
{{else}}
  <p class="muted">No orders yet.</p>
{{/if}}

{{!-- ── Loops: each with else, keys, nested ── --}}
{{#each warehouse.shelves as |shelf shelfIndex|}}
  <section id="shelf-{{shelfIndex}}">
    <h2>{{shelf.label}}</h2>
    {{#each shelf.items as |item|}}
      <p>{{@index}}: {{item.sku}} ({{item.qty}}) in {{../label}} / {{shelf.label}}</p>
      {{#if @last}}<hr>{{/if}}
    {{else}}
      <p>Empty shelf</p>
    {{/each}}
  </section>
{{/each}}

{{#each lookupTable}}
  {{@key}} = {{this}}
{{/each}}

{{!-- ── with, lookup, log ── --}}
{{#with user.profile as |profile|}}
  <p>{{profile.bio}} — {{profile.joined}}</p>
{{else}}
  <p>No profile.</p>
{{/with}}
{{log "rendering orders" level="info"}}
{{#each (take items 3)}}{{this.sku}}{{/each}}

{{!-- ── Partials and blocks ── --}}
{{> header}}
{{> (lookup . "layoutName") title="Orders"}}
{{> userCard user=user compact=true}}
{{#> layout title="Orders"}}
  <p>Content passed to the layout block.</p>
{{/layout}}
{{#> card}}
  {{#*inline "title"}}Custom title{{/inline}}
  <p>Card body</p>
{{/card}}
{{#*inline "row"}}
  <tr><td>{{name}}</td></tr>
{{/inline}}
{{> row name="inline partial"}}
{{#> @partial-block}}{{/@partial-block}}
{{> @partial-block}}

{{!-- ── Subexpressions and helpers ── --}}
{{money (multiply item.qty item.price) currency=(lookup config "currency")}}
{{#if (and (gt qty 0) (or inStock backorder))}}Available{{/if}}
{{#if (not (eq status "cancelled"))}}Live{{/if}}
{{uppercase (trim (concat firstName " " lastName))}}

{{!-- ── Custom block helpers ── --}}
{{#repeat 3}}
  <span>{{@index}}</span>
{{/repeat}}

{{#list people}}
  {{firstName}} {{lastName}}
{{/list}}

{{#form action="/orders" method="post"}}
  <input name="sku" value="{{sku}}">
{{/form}}

{{!-- ── Decorators and raw blocks ── --}}
{{* decorator arg}}
{{{{raw}}}}
  {{this is not evaluated}} {{#if x}}raw{{/if}}
{{{{/raw}}}}

