</style>
<script>
  window.__ORDERS__ = {{{json orders}}};
  const title = "{{title}}";
</script>
<a href="{{url}}?q={{encodeURIComponent query}}" class="{{#if active}}active{{/if}}" {{#if disabled}}disabled{{/if}}>Link</a>

