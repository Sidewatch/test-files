<!DOCTYPE inventory SYSTEM "inventory.dtd" [
  <!-- Internal DTD subset -->
  <!ELEMENT inventory (meta, warehouse+)>
  <!ELEMENT meta (title, updated?, note*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT updated (#PCDATA)>
  <!ELEMENT note (#PCDATA | em)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT warehouse (location, (item | bundle)*)>
  <!ELEMENT location EMPTY>
  <!ELEMENT item (name, price, tags?, description?)>
  <!ELEMENT bundle (item+)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT description ANY>
  <!ATTLIST warehouse
            id        ID                      #REQUIRED
            region    (north | south | east)  "north"
            capacity  CDATA                   #IMPLIED
            version   CDATA                   #FIXED "2.1"
            refs      IDREFS                  #IMPLIED
            owner     IDREF                   #IMPLIED
            kind      NMTOKEN                 #IMPLIED
            kinds     NMTOKENS                #IMPLIED
            logo      ENTITY                  #IMPLIED
            format    NOTATION (png | svg)    #IMPLIED>
  <!ATTLIST item sku CDATA #REQUIRED qty CDATA "0" xml:lang CDATA #IMPLIED>
  <!ENTITY company "Acme Supply &amp; Co.">
  <!ENTITY copyright "&#169; 2026 &company;">
  <!ENTITY % currency "GBP">
  <!ENTITY % shared SYSTEM "shared.ent">
  %shared;
  <!ENTITY external SYSTEM "external.xml">
  <!ENTITY public-ent PUBLIC "-//ACME//ENTITIES Stock//EN" "stock.ent">
  <!ENTITY logo-img SYSTEM "logo.png" NDATA png>
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION svg PUBLIC "-//W3C//DTD SVG 1.1//EN" "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd">
  <?processing-in-dtd instruction?>
]>
