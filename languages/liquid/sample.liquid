{% comment %}
  Liquid 5.x (Shopify theme tags and filters, plus common Jekyll filters) — syntax showcase: a storefront product-grid template exercising the whole language.
  TODO: paginate collections. FIXME: sold-out badge.
{% endcomment %}
{%- # Inline comment tag (single line) -%}
{% doc %}
  @param {Product} product - the product to render
  @param {string} [heading] - optional heading
{% enddoc %}

{%- liquid
  # Liquid tag: multiple statements without delimiters
  assign on_sale = collection.products | where: "compare_at_price"
  assign heading = collection.title | default: "Products" | upcase
  if on_sale.size > 0
    echo "sale"
  endif
-%}

{% assign integer = 42 %}
{% assign negative = -17 %}
{% assign float = 3.14159 %}
{% assign yes = true %}
{% assign no = false %}
{% assign nothing = nil %}
{% assign other_nothing = null %}
{% assign empty_check = blank %}
{% assign text = 'single "quoted" string' %}
{% assign text2 = "double 'quoted' string with unicode: Zürich → 東京 ✓" %}
{% assign range = (1..5) %}
{% assign range_var = (1..product.variants.size) %}
{% assign array = "a,b,c" | split: "," %}
{% capture banner %}
  Welcome to {{ shop.name }} — {{ "now" | date: "%Y-%m-%d %H:%M" }}
{% endcapture %}
{% increment counter %}
{% decrement counter %}

<h1>{{ heading }}</h1>
<p class="{{ settings.class | default: 'plain' }}">{{ banner | strip | escape }}</p>

{% if on_sale.size > 0 %}
  <p>{{ on_sale.size }} on sale — up to {{ on_sale | map: "discount_percent" | sort | last }}% off</p>
{% elsif collection.products.size == 0 %}
  <p>Nothing here</p>
{% else %}
  <p>No sale</p>
{% endif %}

{% if product.title contains "Widget" and product.price >= 1000 or product.tags contains 'new' %}
  <span>match</span>
{% endif %}
{% if product.vendor != "Acme" and product.price <= 5000 and product.type == empty %}x{% endif %}
{% if product.price < 100 and product.price > 10 and product.compare_at_price == nil %}y{% endif %}
{% if collection.title == blank %}z{% endif %}

{% unless product.available %}
  <span class="badge">Sold out</span>
{% else %}
  <span class="badge">In stock</span>
{% endunless %}

{% case product.type %}
  {% when "shirt", "top" %}Clothing
  {% when 'mug' or 'cup' %}Kitchen
  {% else %}Other
{% endcase %}

<ul class="grid">
  {% for product in collection.products limit: 12 offset: 2 reversed %}
    <li class="{% cycle 'odd', 'even' %} {% cycle 'group': 'a', 'b', 'c' %}">
      {%- if forloop.first %}<!-- first -->{% endif -%}
      <a href="{{ product.url | within: collection }}">
        <img src="{{ product.featured_image | img_url: '300x300', crop: 'center' }}" alt="{{ product.title | escape }}">
        {{ forloop.index }}/{{ forloop.length }} ({{ forloop.index0 }}, {{ forloop.rindex }}, {{ forloop.rindex0 }})
        {{ product.title | truncate: 30, "…" }} — {{ product.price | money_with_currency }}
      </a>
      {% unless product.available %}<span class="badge">Sold out</span>{% endunless %}
      {% if forloop.last %}<!-- last -->{% endif %}
      {% if product.hidden %}{% continue %}{% endif %}
      {% if forloop.index > 20 %}{% break %}{% endif %}
    </li>
  {% else %}
    <li>No products yet.</li>
  {% endfor %}
</ul>

{% for i in (1..3) %}{{ i }}{% unless forloop.last %}, {% endunless %}{% endfor %}
{% for item in array %}{{ item }}{% endfor %}

{% tablerow product in collection.products cols: 3 limit: 6 %}
  {{ product.title }} {{ tablerowloop.col }} {{ tablerowloop.row }} {{ tablerowloop.col_first }} {{ tablerowloop.col_last }}
{% endtablerow %}

{% paginate collection.products by 12 %}
  {{ paginate.current_page }} of {{ paginate.pages }}
{% endpaginate %}

{% form 'contact', class: 'contact-form', id: "contact" %}
  <input type="email" name="contact[email]" value="{{ form.email }}">
{% endform %}

{% style %}
  .brand { color: {{ settings.brand_color }}; }
{% endstyle %}
{% stylesheet %}
  .grid { display: grid; }
{% endstylesheet %}
{% javascript %}
  console.log("{{ shop.name | escape }}");
{% endjavascript %}
{% schema %}
{ "name": "Product grid", "settings": [{ "type": "range", "id": "limit", "min": 1, "max": 24, "default": 12 }] }
{% endschema %}

{% raw %}{{ not rendered }} {% not a tag %}{% endraw %}

{% render 'pagination', paginate: paginate, label: "Pages" %}
{% render 'product-card' for collection.products as product %}
{% render 'icon' with 'arrow' %}
{% include 'legacy-snippet' %}
{% section 'header' %}
{% layout none %}
{% sections 'footer-group' %}
