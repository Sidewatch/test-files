{% liquid
  assign x = 1
  # a comment inside the liquid tag
  for i in (1..3)
    echo i | plus: x
    if i == 2
      break
    endif
  endfor
  case x
    when 1
      echo "one"
    else
      echo "other"
  endcase
  capture c
