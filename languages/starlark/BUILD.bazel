def sku_label(sku, prefix = "SKU", *rest, upper = False, **extra):
    """Format a SKU label.

    Args:
      sku: the stock keeping unit.
      prefix: label prefix.
      *rest: extra pieces joined with dashes.
      upper: uppercase the result.
      **extra: ignored keyword arguments.

    Returns:
      The formatted label.
    """
    parts = [prefix, sku] + list(rest)
    label = "-".join(parts)
    if upper:
        label = label.upper()
    elif len(label) > 40:
        label = label[:40]
    else:
        pass
    return label

def _impl(ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".txt")
    ctx.actions.write(output = out, content = "version=%s\n" % ctx.attr.version)
    for src in ctx.files.srcs:
        if src.extension == "c":
            continue
        elif src.basename == "stop":
            break
    return [DefaultInfo(files = depset([out]))]

def fibonacci(n):
    a, b = 0, 1
    for _ in range(n):
        a, b = b, a + b
    return a

def with_lambda(items):
    return sorted(items, key = lambda item: (-item["qty"], item["sku"]))

def check(value):
    if type(value) == "string" and len(value) > 0:
        return True
    fail("expected a non-empty string, got %r" % (value,))

