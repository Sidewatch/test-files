    var paidCount = Model.Orders.Count(o => o.IsPaid);
    const int MaxRows = 100;
    string verbatim = @"C:\temp\inventory";
    var interpolated = $"{paidCount,5:N0} of {Model.Orders.Count}";
    var raw = """a "raw" string""";
    int hex = 0xFF, binary = 0b1010, big = 1_000_000;
    double dbl = 1.5e-3; float flt = 2.5f; decimal money = 19.99m; long l = 42L; char ch = '\n';
