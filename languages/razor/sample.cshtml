@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@attribute [StreamRendering]
@attribute [Authorize]
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Counter</PageTitle>
<HeadContent><meta name="description" content="Counter page" /></HeadContent>

<h2>Current count: @current</h2>
<button class="btn" @onclick="Increment">Click</button>
<button @onclick="() => current += 5">Add 5</button>
<button @onclick="async () => await SaveAsync()" @onclick:preventDefault @onclick:stopPropagation>Save</button>
<button @ondblclick="Reset" @onmouseover="@(e => Hover(e))" disabled="@(current > 10)">Reset</button>
<input @bind="name" @bind:event="oninput" @bind:after="OnNameChanged" />
<input @bind:get="name" @bind:set="SetName" />
<input @bind="current" @bind:format="N0" @bind:culture="culture" />
<input type="checkbox" @bind="flag" />
<input @ref="inputRef" @key="current" @attributes="extra" @onkeydown="OnKey" @onkeydown:preventDefault="true" />
<select @bind="selected">
    @foreach (var opt in options)
    {
        <option value="@opt" selected="@(opt == selected)">@opt</option>
    }
</select>

<EditForm Model="form" OnValidSubmit="Submit" FormName="order" Enhance>
    <DataAnnotationsValidator />
    <ValidationSummary />
    <AntiforgeryToken />
    <InputText @bind-Value="form.Sku" class="form-control" />
    <InputNumber @bind-Value="form.Quantity" @bind-Value:after="Recalc" />
    <InputSelect @bind-Value="form.Status">
        @foreach (var s in Enum.GetValues<OrderStatus>())
        {
            <option value="@s">@s</option>
        }
    </InputSelect>
    <ValidationMessage For="() => form.Sku" />
    <button type="submit">Send</button>
</EditForm>

<CascadingValue Value="theme" Name="Theme" IsFixed="true">
    <ThemedPanel Title="Panel" OnChange="@((int v) => current = v)">
        <ChildContent>Inner content</ChildContent>
        <Footer Context="footer">Footer @footer.Text</Footer>
    </ThemedPanel>
</CascadingValue>

<Virtualize Items="items" Context="item" ItemSize="30">
    <ItemContent><div>@item.Name</div></ItemContent>
    <Placeholder>Loading...</Placeholder>
</Virtualize>

<DynamicComponent Type="componentType" Parameters="parameters" />
<GenericList TItem="Order" Items="orders" Context="o"><RowTemplate>@o.Number</RowTemplate></GenericList>
<NavLink class="nav-link" href="counter" Match="NavLinkMatch.All">Counter</NavLink>
<ErrorBoundary><ChildContent>@ChildContent</ChildContent><ErrorContent Context="ex">Oops: @ex.Message</ErrorContent></ErrorBoundary>
<Router AppAssembly="typeof(Program).Assembly"><Found Context="routeData"><RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" /></Found></Router>
<Routes @rendermode="InteractiveServer" />
<script>window.focusElement = (el) => el.focus();</script>

