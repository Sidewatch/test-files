<!-- HTML comment @name -->
@code {
    [Parameter] public int Start { get; set; }
    [Parameter] public EventCallback<int> OnChange { get; set; }
    [CascadingParameter] public Theme Theme { get; set; } = default!;

    private int current;

    protected override async Task OnInitializedAsync()
    {
        current = Start;
        await Task.Delay(10);
    }

    private void Increment() => current++;
    public void Dispose() { }

    [SupplyParameterFromForm] private OrderForm form { get; set; } = new();
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment<Order>? RowTemplate { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? extra { get; set; }
    [Inject] private ILogger<Counter> Log { get; set; } = default!;
    private ElementReference inputRef;
    private string? name;
    private string culture = "en-GB";
    private bool flag;
    private string selected = "a";
    private readonly string[] options = ["a", "b", "c"];

    // C# 14: the field keyword in accessors, extension members, null-conditional assignment
    public string Title { get => field ?? "untitled"; set => field = value?.Trim(); }
    private void Touch() { Model?.Items = []; }
    private async Task SaveAsync() { await JS.InvokeVoidAsync("console.log", "saved"); }
    private Task OnNameChanged() => Task.CompletedTask;
    private void SetName(string value) => name = value;
    private void Hover(MouseEventArgs e) { }
    private void OnKey(KeyboardEventArgs e) { }
    private void Reset() => current = 0;
    private void Recalc() { }
    private Task Submit() => Task.CompletedTask;
    public async ValueTask DisposeAsync() { await Task.CompletedTask; }
    protected override void BuildRenderTree(RenderTreeBuilder builder) { }
    protected override bool ShouldRender() => true;
    protected override async Task OnParametersSetAsync() { }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await inputRef.FocusAsync(); }
    private record Point(int X, int Y);
    private class OrderForm { [Required, StringLength(8)] public string Sku { get; set; } = ""; public int Quantity { get; set; } }
}
