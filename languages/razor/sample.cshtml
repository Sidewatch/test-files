    <input asp-for="Quantity" class="form-control" />
    <span asp-validation-for="Quantity" class="text-danger"></span>
    <select asp-for="Warehouse" asp-items="Model.Warehouses"></select>
    <button type="submit" class="btn btn-primary" disabled="@(!Model.CanSubmit)">Save</button>
}

@lock (this)
{
    <p>Locked</p>
}

