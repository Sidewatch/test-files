%%{init: {"theme": "neutral", "securityLevel": "loose"}}%%
%% Mermaid showcase: one diagram per family. Comments start with two percent signs.

flowchart TB
    direction LR
    A[Receive goods] --> B{Inspect?}
    B -->|pass| C(Shelve)
    B -- fail --> D([Quarantine])
    C ==> E[(Stock DB)]
    D -.-> F((Return))
    E --- G>Flag]
    G --o H{{Hexagon}}
    H --x I[/Parallelogram/]
    I <--> J[\Alt parallelogram\]
    J --> K[/Trapezoid\]
    K --> L[\Inverse trapezoid/]
    L --> M[["Subroutine"]]
    M --> N@{ shape: cloud, label: "Cloud" }
    subgraph Dock["Loading dock"]
        direction TB
        P1 --> P2
    end
    A --> Dock
    classDef hot fill:#f96,stroke:#333,stroke-width:2px,color:#000
    class A,B hot
    style C fill:#bbf,stroke:#33f
    linkStyle 0 stroke:#ff3,stroke-width:4px
    click A "https://example.com/receive" "Open receiving" _blank
    click B callback "Tooltip"

sequenceDiagram
    autonumber
    participant W as Warehouse
    actor U as Picker
    participant API
    box rgb(200,220,255) Backend
        participant DB
    end
    U->>W: Request pick list
    activate W
    W-->>U: List ready
    W->>+API: POST /orders
    API-)DB: Async write
    API-xW: Rejected
    API--)W: Notified
    deactivate W
    Note over U,W: Both parties agree
    Note right of API: Retries 3 times
    alt in stock
        W->>U: Ship
    else backordered
        W->>U: Delay
    end
    opt gift wrap
        U->>W: Wrap it
    end
    loop every minute
        API->>DB: Heartbeat
    end
    par to north
        W->>API: sync
    and to south
        W->>API: sync
    end
    critical connect
        API->>DB: open
    option timeout
        API->>W: fail
    end
    break when full
        W->>U: stop
    end
    rect rgb(240, 240, 255)
        U->>W: highlighted
    end
    create participant Label
    W->>Label: print
    destroy Label
    Label-->>W: done

classDiagram
    direction RL
    class Item {
        <<abstract>>
        +String sku
        -int qty
        #double price
        ~List~string~ tags
        +restock(int amount) bool
        +price() double$
        +audit()* void
    }
    class Pallet~T~ {
        +List~T~ items
    }
    <<interface>> Shippable
    Item <|-- Widget : inherits
    Item *-- Pallet : composition
    Item o-- Rack : aggregation
    Item --> Shippable : association
    Item ..> Log : dependency
    Item ..|> Shippable : realization
    Item "1" --> "0..*" Tag : has
    note for Item "Root of all stock"
    link Item "https://example.com" "Docs"
    callback Item "onClick" "Tip"

stateDiagram-v2
    [*] --> Pending
    Pending --> Paid : payment ok
    Pending --> Cancelled : timeout / user
    Paid --> Shipped : picked & packed
    state Shipped {
        [*] --> InTransit
        InTransit --> Delivered
        --
        [*] --> Tracking
    }
    state fork_state <<fork>>
    state join_state <<join>>
    state choice_state <<choice>>
    Shipped --> [*]
    Cancelled --> [*]
    note right of Paid
        A paid order can still be
        cancelled within 1 hour.
    end note
    note left of Pending : Waiting for payment
    classDef bad fill:#f00,color:white
    class Cancelled bad

erDiagram
    CUSTOMER ||--o{ ORDER : places
    ORDER ||--|{ LINE_ITEM : contains
    PRODUCT }o--o{ CATEGORY : "belongs to"
    PRODUCT ||..o| SUPPLIER : "sourced from"
    CUSTOMER {
        string name PK "Full name"
        string email UK
        int age
    }
    LINE_ITEM {
        int qty
        string sku FK
    }

