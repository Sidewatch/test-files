// RON 0.12 (Rusty Object Notation) — syntax showcase
// ── Comments ──
// RON (Rusty Object Notation) showcase: a warehouse service configuration.
// TODO: split per environment. FIXME: ports are not validated.

/* A block comment
   /* with a nested block comment */
   spanning lines. */

/// Doc comments are ordinary comments in RON.

// ── Extensions ──
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

// ── The root value ──
Config(
    // Strings
    name: "inventory-api",
    version: "1.4.0",
    description: "Escapes: \"quote\" \\ backslash \n newline \t tab \r return \u{1F4E6} \x41 \u00e9",
    multiline: "line one
line two",
    continuation: "joined \
                   across lines",
    raw: r"C:\raw\path with no escapes",
    raw_hashes: r#"raw with "quotes" inside"#,
    raw_more: r##"raw with "# inside"##,
    byte_string: b"bytes \x00\xff",
    raw_bytes: br#"raw bytes "here""#,

    // Characters
    initial: 'p',
    newline: '\n',
    quote: '\'',
    unicode_char: '\u{00e9}',
    hex_char: '\x41',

    // Numbers
    replicas: 3,
    negative: -42,
    positive: +7,
    underscore: 1_000_000,
    hex: 0xFF,
    hex_upper: 0xDEAD_BEEF,
    octal: 0o755,
    binary: 0b1010_0101,
    ratio: 0.75,
    float_exp: 1.5e-3,
    float_exp2: 6.022E23,
    float_leading: 1.,
    float_neg: -0.5,
    infinity: inf,
    neg_infinity: -inf,
    not_a_number: NaN,

    // Booleans
    debug: false,
    enabled: true,

    // Unit and options
    nothing: (),
    maybe: None,
    something: Some("value"),
    nested_option: Some(Some(5)),
    implicit: "implicit some via the extension",

    // Lists and tuples
    ports: [8080, 9090],
    empty_list: [],
    trailing_comma: [
        "a",
        "b",
    ],
    nested_list: [[1, 2], [3, 4]],
    tags: ("eu-west-1", 'p', 3.5, true),
    single_tuple: (1,),

    // Maps
    env: {
        "LOG_LEVEL": "info",
        "FEATURE_FLAGS": "search,export",
        "EMPTY": "",
    },
    numeric_keys: {
        1: "one",
        2: "two",
    },
    struct_keys: {
        (1, 2): "point",
        Red: "enum key",
    },
    empty_map: {},

    // Structs: named, anonymous and unit
    database: Database(
        host: "db.internal",
        port: 5432,
        ssl: true,
        timeout: Duration(secs: 30, nanos: 0),
        credentials: (user: "inventory", password: "example-not-a-real-password"),
    ),
    anonymous_struct: (
        left: 1,
        right: 2,
    ),
    unit_struct: UnitStruct,
    unit_value: Unit,
    newtype: Meters(12.5),
    raw_identifier: (r#type: "keyword as field", r#fn: 1),

    // Enums: unit, tuple and struct variants
    mode: Production,
    level: Level(3),
    shape: Rectangle(width: 4.0, height: 2.5),
    tuple_variant: Point(1, 2, 3),
    result_ok: Ok("fine"),
    result_err: Err("failed"),
    nested_enum: Outer(Inner(Deep(1))),

    // Nested configuration
    retry: Some(Retry(attempts: 3, backoff_ms: 250, jitter: true)),
    warehouses: [
        Warehouse(
            code: "NORTH",
            bins: [Bin(label: "A1", capacity: 100), Bin(label: "A2", capacity: 80)],
            location: (lat: 51.5074, lon: -0.1278),
            opened: "2026-01-15T09:00:00Z",
        ),
        Warehouse(
            code: "SOUTH",
            bins: [],
            location: (lat: 50.8225, lon: -0.1372),
            opened: "2026-03-01T09:00:00Z",
        ),
    ],

    // Identifiers with unusual shapes
    snake_case_field: 1,
    camelCaseField: 2,
    PascalCaseField: 3,
    field_with_digits_123: 4,
    _leading_underscore: 5,

    // More literal forms
    float_forms: [1e3, 1E-3, 1.5e+10, .5, 5., 0.0, -0.0, 1_000.5, inf, -inf, NaN],
    int_forms: [0, -0, +0, 0xff, 0xFF, 0o17, 0b11, 1_0, 0x_f],
    char_forms: ['a', ' ', '\\', '\'', '"', '\t', '\r', '\0', '\x7f', '\u{1f4e6}', 'λ', '📦'],
    string_forms: ["", " ", "\"", "\\", "\t\n\r", "\0", "\x41", "\u{41}", "\u0041", "🌍 λ é"],
    raw_forms: [r"", r"\n", r#""#, r#"a"b"#, r##"a"#b"##, r###"a"##b"###],
    byte_forms: [b"", b"a", b"\x00\xff\n", br"raw\n", br#"raw"quote"#],
    string_with_continuation: "first \
        second \
        third",
    string_multiline: "a
b
c",

    // Structure forms
    unit_forms: [(), Unit, ()],
    option_forms: [None, Some(1), Some(None), Some(Some(())), Some((1, 2)), Some([1])],
    tuple_forms: [(), (1,), (1, 2), (1, (2, 3)), ((), ())],
    list_forms: [[], [1], [1,], [1, 2], [[], [[]]]],
    map_forms: [{}, {1: 2}, {1: 2,}, {"a": {"b": {"c": 1}}}, {Some(1): None, None: Some(2)}, {(1, 2): [3]}, {'k': 'v'}, {1.5: 2.5}],
    struct_forms: [
        Named(),
        Named(a: 1),
        Named(a: 1,),
        Named(a: 1, b: Named(c: 2)),
        (a: 1),
        (a: 1, b: (c: (d: 2))),
        (),
    ],
    tuple_struct_forms: [Tuple(), Tuple(1), Tuple(1, 2), Tuple(1, Tuple(2)), Wrapper(Some(1)), Wrapper([1, 2])],
    enum_forms: [A, B(1), C(1, 2), D(x: 1), E(x: 1, y: 2), F(G(H(I)))],
    identifier_forms: [a, A, a1, A1, _a, _, a_b, A_B, aA, r#type, r#struct, r#fn, r#true, r#1],
    keyword_like: [true, false, None, Some(true), (true, false)],
    nested_everything: Root(
        list: [Item(id: 1, tags: ["x"], meta: {"k": (1, 2)}), Item(id: 2, tags: [], meta: {})],
        flag: Some(true),
        pair: (Some(1), None),
    ),
    comments_inline: [1, /* block */ 2, // line
        3],
    spacing:Compact(a:1,b:[1,2],c:{1:2}),
)
