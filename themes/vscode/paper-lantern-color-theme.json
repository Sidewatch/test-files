{
  "name": "Paper Lantern",
  "colors": {
    "editor.background": "#FBF7EF",
    "editor.foreground": "#2F2A24",
    "editorCursor.foreground": "#B2401E",
    "editor.selectionBackground": "#E9DCC3",
    "editorLineNumber.foreground": "#B8AD9A",
    "statusBar.background": "#EFE7D8",
    "statusBar.foreground": "#5A5045"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#8C8173", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#3D7A2E" } },
    { "scope": "keyword", "settings": { "foreground": "#9B2C6E" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#1F5FA8" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#B2401E" } }
  ]
}
