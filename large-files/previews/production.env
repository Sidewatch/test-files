SERVICE_06751_EXPANDED="${SERVICE_06751_HOST}:${SERVICE_06751_PORT}"
SERVICE_06751_FLAGS=manual-v2,studio-beta # an inline comment
SERVICE_06751_EMPTY=
SERVICE_06751_MULTILINE="first line
second line"

