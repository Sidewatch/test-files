SERVICE_06532_EXPANDED="${SERVICE_06532_HOST}:${SERVICE_06532_PORT}"
SERVICE_06532_FLAGS=update-v2,account-beta # an inline comment
SERVICE_06532_EMPTY=
SERVICE_06532_MULTILINE="first line
second line"

