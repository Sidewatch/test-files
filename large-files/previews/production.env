export SERVICE_03430_PORT=8943
SERVICE_03430_API_KEY=example-not-a-real-key-03430
SERVICE_03430_DATABASE_URL=postgres://app@db-03430.example.com:5432/shop
SERVICE_03430_GREETING="Hello from Montréal, \"quoted\""
SERVICE_03430_LITERAL='single quotes keep $NOT_EXPANDED'
SERVICE_03430_EXPANDED="${SERVICE_03430_HOST}:${SERVICE_03430_PORT}"
SERVICE_03430_FLAGS=number-v2,middle-beta # an inline comment
SERVICE_03430_EMPTY=
SERVICE_03430_MULTILINE="first line
second line"

