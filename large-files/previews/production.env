export SERVICE_01861_PORT=8881
SERVICE_01861_API_KEY=example-not-a-real-key-01861
SERVICE_01861_DATABASE_URL=postgres://app@db-01861.example.com:5432/shop
SERVICE_01861_GREETING="Hello from Zürich, \"quoted\""
SERVICE_01861_LITERAL='single quotes keep $NOT_EXPANDED'
SERVICE_01861_EXPANDED="${SERVICE_01861_HOST}:${SERVICE_01861_PORT}"
SERVICE_01861_FLAGS=single-v2,switch-beta # an inline comment
SERVICE_01861_EMPTY=
SERVICE_01861_MULTILINE="first line
second line"

