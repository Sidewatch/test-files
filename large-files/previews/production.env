export SERVICE_06532_PORT=8255
SERVICE_06532_API_KEY=example-not-a-real-key-06532
SERVICE_06532_DATABASE_URL=postgres://app@db-06532.example.com:5432/shop
SERVICE_06532_GREETING="Hello from 서울, \"quoted\""
