export SERVICE_04525_PORT=8932
SERVICE_04525_API_KEY=example-not-a-real-key-04525
SERVICE_04525_DATABASE_URL=postgres://app@db-04525.example.com:5432/shop
SERVICE_04525_GREETING="Hello from São Paulo, \"quoted\""
SERVICE_04525_LITERAL='single quotes keep $NOT_EXPANDED'
SERVICE_04525_EXPANDED="${SERVICE_04525_HOST}:${SERVICE_04525_PORT}"
SERVICE_04525_FLAGS=linear-v2,cargo-beta # an inline comment
SERVICE_04525_EMPTY=
SERVICE_04525_MULTILINE="first line
second line"

