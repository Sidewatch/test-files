export SERVICE_00292_PORT=8707
SERVICE_00292_API_KEY=example-not-a-real-key-00292
SERVICE_00292_DATABASE_URL=postgres://app@db-00292.example.com:5432/shop
SERVICE_00292_GREETING="Hello from Málaga, \"quoted\""
SERVICE_00292_LITERAL='single quotes keep $NOT_EXPANDED'
SERVICE_00292_EXPANDED="${SERVICE_00292_HOST}:${SERVICE_00292_PORT}"
SERVICE_00292_FLAGS=equal-v2,safety-beta # an inline comment
SERVICE_00292_EMPTY=
SERVICE_00292_MULTILINE="first line
second line"

