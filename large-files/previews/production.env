export SERVICE_00219_PORT=8476
SERVICE_00219_API_KEY=example-not-a-real-key-00219
SERVICE_00219_DATABASE_URL=postgres://app@db-00219.example.com:5432/shop
SERVICE_00219_GREETING="Hello from Tōkyō, \"quoted\""
SERVICE_00219_LITERAL='single quotes keep $NOT_EXPANDED'
SERVICE_00219_EXPANDED="${SERVICE_00219_HOST}:${SERVICE_00219_PORT}"
SERVICE_00219_FLAGS=method-v2,carbon-beta # an inline comment
SERVICE_00219_EMPTY=
SERVICE_00219_MULTILINE="first line
second line"

